# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 GitHub에 올라가지 않는다.
ONTONG_API_KEY=온통청년에서_발급받은_키

# 정책 자동 수집(6시간마다)을 켜려면 true
ONTONG_SYNC_SCHEDULED=false

# Docker Compose 포트와 이미지 이름 (기본값을 바꿀 때만 설정)
# APP_PORT=8080
# POSTGRES_PORT=5432
# 서버에서 GHCR 이미지를 사용할 때: ghcr.io/samsamosip/backend:latest
# APP_IMAGE=ghcr.io/samsamosip/backend:latest
# POSTGRES_DB=youthbenefit
# POSTGRES_USER=youthbenefit
# POSTGRES_PASSWORD=youthbenefit

# Docker 없이 직접 띄운 PostgreSQL을 쓸 때만 아래를 채우고 DOCKER_COMPOSE_ENABLED=false
# DOCKER_COMPOSE_ENABLED=false
# DB_URL=jdbc:postgresql://localhost:5432/youthbenefit
# DB_USERNAME=youthbenefit
# DB_PASSWORD=youthbenefit

# 학교 장학 데이터 (Policy Harvester). 키는 관리자 화면 > API key 에서 발급
HARVESTER_BASE_URL=https://policy-harvester-api.gdgoc.dev
HARVESTER_API_KEY=발급받은_키
